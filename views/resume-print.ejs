<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resume</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    html, body { margin: 0; padding: 0; width: 794px; background: #fff; }
  </style>
</head>
<body>
  <%
    const template = resumeData.template || 'modern';
    const color = resumeData.accentColor || '#6C63FF';
  %>
  <% if (template === 'modern') { %>
    <%- include('templates/modern', { resumeData, color }) %>
  <% } else if (template === 'classic') { %>
    <%- include('templates/classic', { resumeData, color }) %>
  <% } else if (template === 'minimal') { %>
    <%- include('templates/minimal', { resumeData, color }) %>
  <% } else if (template === 'bold') { %>
    <%- include('templates/bold', { resumeData, color }) %>
  <% } else if (template === 'creative') { %>
    <%- include('templates/creative', { resumeData, color }) %>
  <% } else if (template === 'executive') { %>
    <%- include('templates/executive', { resumeData, color }) %>
  <% } else { %>
    <%- include('templates/modern', { resumeData, color }) %>
  <% } %>
</body>
</html>
