<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title }) %>
  <style>
    body { background: #0f0f1a; }
    .preview-layout { display: flex; flex-direction: column; min-height: 100vh; }
    .preview-toolbar {
      position: sticky; top: 0; z-index: 100;
      background: rgba(15,15,26,0.95); backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 12px 24px;
      display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    }
    .preview-toolbar .brand { font-family: 'Syne', sans-serif; font-weight: 700; color: #fff; text-decoration: none; font-size: 1.1rem; }
    .preview-toolbar .brand span { color: #6C63FF; }
    .preview-toolbar-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
    .btn-download-pdf {
      background: linear-gradient(135deg, #6C63FF, #9b6dff);
      color: #fff; border: none; padding: 10px 24px; border-radius: 10px;
      font-weight: 600; display: flex; align-items: center; gap: 8px;
      cursor: pointer; transition: all 0.3s; font-size: 0.9rem;
    }
    .btn-download-pdf:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(108,99,255,0.4); color: #fff; }
    .btn-download-pdf.loading { opacity: 0.7; pointer-events: none; }
    .btn-edit { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); padding: 10px 20px; border-radius: 10px; font-weight: 500; font-size: 0.9rem; transition: all 0.2s; }
    .btn-edit:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .preview-stage { flex: 1; display: flex; justify-content: center; align-items: flex-start; padding: 40px 20px; }
    .resume-paper {
      background: #fff; width: 794px; min-height: 1123px;
      box-shadow: 0 40px 120px rgba(0,0,0,0.6);
      border-radius: 4px; overflow: hidden;
      animation: paperReveal 0.6s ease;
    }
    @keyframes paperReveal { from { opacity: 0; transform: translateY(30px) scale(0.98); } to { opacity: 1; transform: none; } }
    @media (max-width: 840px) { .resume-paper { width: 100%; } }
    .preview-hint { text-align: center; color: rgba(255,255,255,0.4); font-size: 0.8rem; padding-bottom: 20px; }
  </style>
</head>
<body>
  <div class="preview-layout">
    <div class="preview-toolbar">
      <a href="/" class="brand">Resume<span>Forge</span></a>
      <div class="preview-toolbar-actions">
        <a href="/resume/builder" class="btn btn-edit">
          <i class="fas fa-edit me-1"></i>Edit Resume
        </a>
        <button class="btn btn-download-pdf" id="downloadBtn">
          <i class="fas fa-file-pdf"></i>
          <span>Download PDF</span>
        </button>
      </div>
    </div>

    <div class="preview-stage">
      <div class="resume-paper" id="resumePaper">
        <%
          const template = resumeData.template || 'modern';
          const color = resumeData.accentColor || '#6C63FF';
          const p = resumeData.personal;
        %>

        <% if (template === 'modern') { %>
          <%- include('templates/modern', { resumeData, color }) %>
        <% } else if (template === 'classic') { %>
          <%- include('templates/classic', { resumeData, color }) %>
        <% } else if (template === 'minimal') { %>
          <%- include('templates/minimal', { resumeData, color }) %>
        <% } else if (template === 'bold') { %>
          <%- include('templates/bold', { resumeData, color }) %>
        <% } else if (template === 'creative') { %>
          <%- include('templates/creative', { resumeData, color }) %>
        <% } else if (template === 'executive') { %>
          <%- include('templates/executive', { resumeData, color }) %>
        <% } else { %>
          <%- include('templates/modern', { resumeData, color }) %>
        <% } %>
      </div>
    </div>
    <p class="preview-hint"><i class="fas fa-info-circle me-1"></i>PDF output matches this preview exactly &middot; A4 format</p>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('downloadBtn').addEventListener('click', async function() {
      const btn = this;
      const span = btn.querySelector('span');
      btn.classList.add('loading');
      span.textContent = 'Generating...';
      try {
        const res = await fetch('/resume/download-pdf');
        if (!res.ok) throw new Error('PDF generation failed');
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'resume.pdf';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        span.textContent = 'Downloaded!';
        setTimeout(() => { span.textContent = 'Download PDF'; btn.classList.remove('loading'); }, 2000);
      } catch(e) {
        span.textContent = 'Error — Try Again';
        btn.classList.remove('loading');
        setTimeout(() => { span.textContent = 'Download PDF'; }, 2000);
      }
    });
  </script>
</body>
</html>
